# Ambiente
NODE_ENV=development
PORT=4000

# Base de dados (PostgreSQL)
DATABASE_URL="postgresql://ao_market_user:CHANGE_ME@localhost:5432/ao_market?schema=public"

# Autenticação
# Access token: JWT de vida curta, validado em cada pedido autenticado.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="15m"
# Refresh token: NÃO é um JWT — é um valor opaco entregue num cookie
# httpOnly; só o hash dele fica na base de dados (tabela RefreshToken).
# Por isso não existe aqui um "JWT_REFRESH_SECRET" a assinar nada.
JWT_REFRESH_EXPIRES_IN="30d"

# CORS
FRONTEND_URL="http://localhost:5173"

# Uploads
UPLOAD_MAX_SIZE_MB=5

# Email (a configurar na Fase 8)
EMAIL_FROM=""
EMAIL_PROVIDER_API_KEY=""

# --- Módulo Segurança Social (INSS) ---
# Chave de 32+ caracteres usada para cifrar dados sensíveis (ex: NISS).
# Gera um valor aleatório forte e único por ambiente. Nunca commitar o valor real.
SOCIAL_SECURITY_ENCRYPTION_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Enquanto não existir integração oficial autorizada pelo INSS, mantém-se
# "false" e o módulo funciona em modo documental/manual (verificação por
# operadores do AO MARKET). Nunca mudar para "true" sem uma API oficial real.
INSS_INTEGRATION_ENABLED=false

# Preenchidos apenas quando existir integração oficial. Nunca colocar
# valores reais neste ficheiro de exemplo nem no código-fonte.
INSS_API_BASE_URL=""
INSS_API_CLIENT_ID=""
INSS_API_CLIENT_SECRET=""
